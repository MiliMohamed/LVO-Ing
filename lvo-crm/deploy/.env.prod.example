# Copier en `.env` (même dossier) sur le VPS — jamais commité.
# Générer chaque secret avec : openssl rand -hex 32

# Domaine public du CRM (enregistrement A → IP du VPS) et e-mail Let's Encrypt
# (une boîte réellement lue : alertes d'expiration de certificat)
CRM_DOMAIN=crm.lvo-ing.com
ACME_EMAIL=contact@lvo-ing.com

POSTGRES_PASSWORD=
JWT_SECRET=
CRM_SERVICE_TOKEN=

MINIO_ROOT_USER=lvo_minio
MINIO_ROOT_PASSWORD=

# Optionnel : si défini, le webhook Qonto exige la signature HMAC
QUONTO_WEBHOOK_SECRET=

# Laisser vide tant qu'ONLYOFFICE n'est pas déployé (figé au build du front)
NEXT_PUBLIC_ONLYOFFICE_URL=

# Images pré-buildées (ex. ghcr.io/<compte>) — sinon build local
REGISTRY=lvo
TAG=latest
