# Base Postgres dédiée au service CRM (docker-compose.yml de ce dossier, port hôte 5434)
DATABASE_URL="postgresql://lvo_crm:lvo_crm_dev_change_me@localhost:5434/lvo_crm_standalone?schema=public"

API_PORT=8081

# Phase 2/3 de la migration : DOIT rester identique au JWT_SECRET de l'ancien projet (server/.env)
# tant que les deux services coexistent — vérification de token stateless, secret partagé.
JWT_SECRET=changez-moi-en-production

# Secret partagé pour authentifier les appels serveur-à-serveur de l'ancien projet
# vers l'API interne exposée par ce service (voir src/internal-api.ts). Phase 3.
CRM_SERVICE_TOKEN=changez-moi-en-production

# Optionnel : si défini, POST /api/webhooks/quonto exige x-qonto-signature (HMAC-SHA256 du corps brut)
QUONTO_WEBHOOK_SECRET=

# ─── MinIO — partagé avec l'ancien projet pour l'instant (docker-compose racine, port 9000) ──
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=lvo_minio
MINIO_SECRET_KEY=lvo_minio_dev_change_me
MINIO_USE_SSL=false

# Gotenberg (conversion DOCX -> PDF) — partagé avec l'ancien projet (docker-compose racine, port 3010)
GOTENBERG_URL=http://127.0.0.1:3010
