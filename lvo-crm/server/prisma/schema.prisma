// Schéma PostgreSQL complet — toutes les entités du store en tables normalisées
// IDs legacy (INT) coexistent avec UUIDs pour compatibilité API existante

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ReferenceEntityType {
  OFFRE
  COMMANDE
  FACTURE

  @@map("reference_entity_type")
}

enum StatutPaiementFacture {
  NON_PAYE
  PARTIELLEMENT_PAYE
  PAYE
  EN_RETARD

  @@map("statut_paiement_facture")
}

enum PaiementSource {
  QUONTO_AUTO
  MANUEL
  IMPORT_CSV

  @@map("paiement_source")
}

enum RelanceNiveau {
  RAPPEL
  PREMIERE_RELANCE
  DEUXIEME_RELANCE
  MISE_EN_DEMEURE

  @@map("relance_niveau")
}

enum RelanceCanal {
  EMAIL
  COURRIER
  TELEPHONE

  @@map("relance_canal")
}

enum ContactClientStatut {
  ACTIF
  ANNULE
  ARCHIVE

  @@map("contact_client_statut")
}

// ─── Utilisateurs ────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  legacyId      Int?     @unique @map("legacy_id")
  email         String   @unique
  passwordHash  String?  @map("password_hash") @db.Text
  role          String   @default("CONSULTANT")
  prenom        String?  @db.VarChar(100)
  nom           String?  @db.VarChar(100)
  telephone     String?  @db.VarChar(50)
  avatarDataUrl String?  @map("avatar_data_url") @db.Text
  agenceId      Int?     @map("agence_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cancelledContacts          Contact[]        @relation("ContactCancelledBy")
  cancelledClients           Client[]         @relation("ClientCancelledBy")
  avoirsCrees                Avoir[]          @relation("AvoirCreatedBy")
  paiementsRapproches        Paiement[]       @relation("PaiementRapprocheBy")
  relancesEnvoyees           Relance[]        @relation("RelanceEnvoyeePar")
  fichiersVersionsUpload     FichierVersion[] @relation("FichierVersionUploadedBy")
  offresConsultantParDefaut  Offre[]          @relation("OffreConsultantDefaut")
  crmTasks                   CrmTask[]
  crmNotifications           CrmNotification[]
  mmsRapports                MmsRapport[]
  refreshTokens              RefreshToken[]

  @@map("users")
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id                  String              @id @default(uuid()) @db.Uuid
  legacyId            Int?                @unique @map("legacy_id")
  raisonSociale       String              @map("raison_sociale")
  entite              String?
  email               String?
  telephone           String?
  siret               String?             @db.VarChar(20)
  codePostal          String?             @map("code_postal") @db.VarChar(10)
  responsableEmail    String?             @map("responsable_email")
  statut              ContactClientStatut @default(ACTIF)
  cancelledAt         DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelledById       String?             @map("cancelled_by") @db.Uuid
  cancellationReason  String?             @map("cancellation_reason") @db.VarChar(200)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  cancelledBy       User?              @relation("ClientCancelledBy", fields: [cancelledById], references: [id])
  sites             Site[]
  siteGestionnaires SiteGestionnaire[]
  offres            Offre[]
  commandes         Commande[]
  appareils         Appareil[]
  devisGroupement   DevisGroupement[]

  @@map("clients")
}

// ─── Contacts ─────────────────────────────────────────────────────────────────

model Contact {
  id                 String              @id @default(uuid()) @db.Uuid
  legacyId           Int?                @unique @map("legacy_id")
  civilite           String?             @db.VarChar(10)
  nom                String
  prenom             String
  entreprise         String?
  fonction           String?
  email              String?
  telephone          String?
  mobile             String?
  ownerUserId        Int?                @map("owner_user_id")
  clientPasswordHash String?             @map("client_password_hash") @db.Text
  statut             ContactClientStatut @default(ACTIF)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?             @map("cancelled_by") @db.Uuid
  cancellationReason String?             @map("cancellation_reason") @db.VarChar(200)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  cancelledBy           User?                  @relation("ContactCancelledBy", fields: [cancelledById], references: [id])
  portalDocuments       ClientPortalDocument[]
  portalInterventions   ClientIntervention[]   @relation("InterventionDeclaredBy")
  clientRefreshTokens   ClientRefreshToken[]
  siteGestionnaires     SiteGestionnaire[]

  @@map("contacts")
}

// ─── Ascensoristes (espace prestataire — dépôt de devis) ──────────────────────

model Ascensoriste {
  id                        String              @id @default(uuid()) @db.Uuid
  legacyId                  Int?                @unique @map("legacy_id")
  entreprise                String
  nom                       String
  prenom                    String
  email                     String              @unique
  telephone                 String?             @db.VarChar(50)
  ascensoristePasswordHash  String?             @map("ascensoriste_password_hash") @db.Text
  statut                    ContactClientStatut @default(ACTIF)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ascensoristes")
}

// ─── Sites ────────────────────────────────────────────────────────────────────

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  legacyId  Int?     @unique @map("legacy_id")
  clientId  String   @map("client_id") @db.Uuid
  nom       String
  typeSite  String?  @map("type_site")
  adresse   String?
  statut    String   @default("ACTIF") @db.VarChar(20)
  imageDataUrl String? @map("image_data_url") @db.Text
  clientNom String?  @map("client_nom") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  offres            Offre[]
  commandes         Commande[]
  siteGestionnaires SiteGestionnaire[]
  equipements       SiteEquipement[]
  equipementsQte    SiteEquipementQte[]
  arborescenceNodes SiteArborescenceNode[]
  portalDocuments   ClientPortalDocument[]
  contrats          ClientContrat[]
  interventions     ClientIntervention[]
  mmsRapports       MmsRapport[]
  appareils         Appareil[]

  @@map("sites")
}

// ─── Équipements par site ────────────────────────────────────────────────────

model SiteEquipement {
  id                  String   @id @default(uuid()) @db.Uuid
  legacyId            Int?     @unique @map("legacy_id")
  siteId              String   @map("site_id") @db.Uuid
  type                String   @db.VarChar(30)
  marque              String?  @db.VarChar(100)
  modele              String?  @db.VarChar(100)
  numeroSerie         String?  @map("numero_serie") @db.VarChar(100)
  anneeInstallation   Int?     @map("annee_installation")
  capaciteKg          Int?     @map("capacite_kg")
  etages              String?  @db.VarChar(200)
  statut              String   @default("ACTIF") @db.VarChar(20)
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  site          Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  interventions ClientIntervention[] @relation("InterventionEquipement")

  @@map("site_equipements")
}

// ─── Équipements du site — inventaire quantitatif (type + nombre) ────────────

model TypeEquipement {
  id        String   @id @default(uuid()) @db.Uuid
  legacyId  Int?     @unique @map("legacy_id")
  libelle   String   @db.VarChar(100)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  siteEquipementsQte SiteEquipementQte[]

  @@unique([libelle])
  @@map("type_equipement")
}

model SiteEquipementQte {
  id               String @id @default(uuid()) @db.Uuid
  legacyId         Int?   @unique @map("legacy_id")
  siteId           String @map("site_id") @db.Uuid
  typeEquipementId String @map("type_equipement_id") @db.Uuid
  quantite         Int    @default(0)

  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  typeEquipement TypeEquipement @relation(fields: [typeEquipementId], references: [id], onDelete: Restrict)

  @@unique([siteId, typeEquipementId])
  @@map("site_equipement")
}

// ─── Arborescence documentaire par site ──────────────────────────────────────

model SiteArborescenceNode {
  id                String    @id @default(uuid()) @db.Uuid
  legacyId          Int?      @unique @map("legacy_id")
  siteId            String    @map("site_id") @db.Uuid
  parentId          String?   @map("parent_id") @db.Uuid
  legacyParentId    Int?      @map("legacy_parent_id")
  nodeType          String    @map("node_type") @db.VarChar(10)
  nom               String    @db.VarChar(500)
  sortOrder         Int       @default(0) @map("sort_order")
  storedPath        String?   @map("stored_path") @db.Text
  minioKey          String?   @map("minio_key") @db.Text
  contentType       String?   @map("content_type") @db.VarChar(200)
  sizeBytes         BigInt?   @map("size_bytes")
  uploadedByUserId  Int?      @map("uploaded_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  site   Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent SiteArborescenceNode? @relation("NodeParent", fields: [parentId], references: [id], onDelete: Cascade)
  children SiteArborescenceNode[] @relation("NodeParent")

  @@map("site_arborescence_nodes")
}

// ─── Offres ───────────────────────────────────────────────────────────────────

model Offre {
  id                        String    @id @default(uuid()) @db.Uuid
  legacyId                  Int?      @unique @map("legacy_id")
  numeroOffre               String    @unique @map("numero_offre") @db.VarChar(50)
  typeMission               String    @map("type_mission") @db.VarChar(10)
  typeMissionsJson          String?   @map("type_missions_json") @db.Text
  statut                    String    @db.VarChar(30)
  montantHt                 Decimal   @map("montant_ht") @db.Decimal(12, 2)
  dateOffre                 DateTime? @map("date_offre") @db.Date
  clientId                  String    @map("client_id") @db.Uuid
  siteId                    String    @map("site_id") @db.Uuid
  clientNom                 String?   @map("client_nom") @db.VarChar(200)
  siteNom                   String?   @map("site_nom") @db.VarChar(200)
  phasesMode                String?   @map("phases_mode") @db.VarChar(20)
  phasesLinesJson           String?   @map("phases_lines_json") @db.Text
  delaisLignesJson          String?   @map("delais_lignes_json") @db.Text
  tauxTva                   Decimal?  @map("taux_tva") @db.Decimal(5, 2)
  consultantEmail           String?   @map("consultant_email")
  gestionnaireNom           String?   @map("gestionnaire_nom")
  gestionnaireContact       String?   @map("gestionnaire_contact") @db.Text
  gestionnaireEmail         String?   @map("gestionnaire_email")
  clientDecisionJson        String?   @map("client_decision_json") @db.Text
  missionsJson              String?   @map("missions_json") @db.Text
  legacyReference           String?   @map("legacy_reference") @db.VarChar(50)
  echeancierFacturationJson Json?     @map("echeancier_facturation_json")
  echeancierExecutionJson   Json?     @map("echeancier_execution_json")
  /// Paramètres de saisie bruts du calcul auto par type de mission (Audit/MM/MOE/MS) — JSON, cf. offre-mission-calc.ts
  missionCalcJson           String?   @map("mission_calc_json") @db.Text
  /// Lignes d'échéancier finales déjà calculées, prêtes pour le rendu Word — { phase, montant, modalite }[]
  echeancierRowsJson        String?   @map("echeancier_rows_json") @db.Text
  consultantParDefautId     String?   @map("consultant_par_defaut_id") @db.Uuid
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client              Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site                Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  consultantParDefaut User?       @relation("OffreConsultantDefaut", fields: [consultantParDefautId], references: [id])
  phases              PhaseOffre[]
  commandes           Commande[]
  fichiers            Fichier[]
  portalDocuments     ClientPortalDocument[]

  @@map("offres")
}

// ─── Commandes ────────────────────────────────────────────────────────────────

model Commande {
  id               String    @id @default(uuid()) @db.Uuid
  legacyId         Int?      @unique @map("legacy_id")
  numeroCommande   String    @unique @map("numero_commande") @db.VarChar(50)
  dateCommande     DateTime? @map("date_commande") @db.Date
  typeMission      String    @map("type_mission") @db.VarChar(10)
  typeMissionsJson String?   @map("type_missions_json") @db.Text
  statut           String?   @db.VarChar(30)
  montantHt        Decimal   @map("montant_ht") @db.Decimal(12, 2)
  montantFacture   Decimal   @map("montant_facture") @db.Decimal(12, 2)
  clientId         String    @map("client_id") @db.Uuid
  siteId           String    @map("site_id") @db.Uuid
  offreId          String?   @map("offre_id") @db.Uuid
  clientNom        String?   @map("client_nom") @db.VarChar(200)
  siteNom          String?   @map("site_nom") @db.VarChar(200)
  legacyReference  String?   @map("legacy_reference") @db.VarChar(50)
  numeroClient     String?   @map("numero_client") @db.VarChar(100)
  gestionnaireNom     String? @map("gestionnaire_nom") @db.VarChar(200)
  gestionnaireContact String? @map("gestionnaire_contact") @db.VarChar(300)
  modePaiementCommande   String? @map("mode_paiement_commande") @db.VarChar(20)
  echeancierPaiementJson String? @map("echeancier_paiement_json") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  offre             Offre?             @relation(fields: [offreId], references: [id])
  factures          Facture[]
  avoirs            Avoir[]
  portalDocuments   ClientPortalDocument[]
  echeancesPaiement EcheancePaiement[]

  @@map("commandes")
}

// ─── Factures ─────────────────────────────────────────────────────────────────

model Facture {
  id                     String                @id @default(uuid()) @db.Uuid
  legacyId               Int?                  @unique @map("legacy_id")
  numeroFacture          String                @unique @map("numero_facture") @db.VarChar(50)
  commandeId             String                @map("commande_id") @db.Uuid
  dateFacture            DateTime?             @map("date_facture") @db.Date
  dateEcheance           DateTime?             @map("date_echeance") @db.Date
  montantHt              Decimal               @map("montant_ht") @db.Decimal(12, 2)
  frais                  Decimal               @default(0) @db.Decimal(12, 2)
  modeReglement          String                @map("mode_reglement") @db.VarChar(30)
  numeroCommandeClient   String?               @map("numero_commande_client") @db.VarChar(100)
  numeroCommandeDisplay  String?               @map("numero_commande_display") @db.VarChar(50)
  clientNom              String?               @map("client_nom") @db.VarChar(200)
  statutPaiement         StatutPaiementFacture @default(NON_PAYE) @map("statut_paiement")
  statutFacturation      String?               @map("statut_facturation") @db.VarChar(20)
  montantPaye            Decimal               @default(0) @map("montant_paye") @db.Decimal(12, 2)
  derniereRelanceAt      DateTime?             @map("derniere_relance_at") @db.Timestamptz(6)
  niveauRelance          Int                   @default(0) @map("niveau_relance")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  commande          Commande           @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  paiements         Paiement[]
  relances          Relance[]
  avoirs            Avoir[]            @relation("AvoirFactureOrigine")
  echeancesPaiement EcheancePaiement[]

  @@index([statutPaiement], map: "idx_factures_statut_paiement")
  @@map("factures")
}

// ─── Échéancier de paiement ─────────────────────────────────────────────────
// Distinct de Commande.echeancierPaiementJson (simple note JSON du mode de
// paiement, saisie manuelle) — modèle relationnel avec statut par ligne et
// lien vers la Facture générée, pilotant le Gantt de trésorerie et la
// facturation automatique.

model EcheancePaiement {
  id           String                 @id @default(uuid()) @db.Uuid
  legacyId     Int?                   @unique @map("legacy_id")
  commandeId   String                 @map("commande_id") @db.Uuid
  ordre        Int
  libelle      String                 @db.VarChar(200)
  pourcentage  Decimal?               @db.Decimal(5, 2)
  montantHt    Decimal                @map("montant_ht") @db.Decimal(12, 2)
  dateEcheance DateTime               @map("date_echeance") @db.Date
  statut       StatutEcheancePaiement @default(A_VENIR)
  factureId    String?                @map("facture_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  commande Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  facture  Facture? @relation(fields: [factureId], references: [id])

  @@index([commandeId], map: "idx_echeances_paiement_commande")
  @@map("echeances_paiement")
}

enum StatutEcheancePaiement {
  A_VENIR
  FACTUREE
  PAYEE
  ANNULEE
}

// ─── Avoirs ───────────────────────────────────────────────────────────────────

model Avoir {
  id               String   @id @default(uuid()) @db.Uuid
  legacyId         Int?     @unique @map("legacy_id")
  numero           String   @unique @db.VarChar(30)
  factureOrigineId String   @map("facture_origine_id") @db.Uuid
  commandeId       String   @map("commande_id") @db.Uuid
  motif            String   @db.VarChar(200)
  montantHt        Decimal  @map("montant_ht") @db.Decimal(12, 2)
  tauxTva          Decimal  @map("taux_tva") @db.Decimal(5, 2)
  montantTtc       Decimal  @map("montant_ttc") @db.Decimal(12, 2)
  dateEmission     DateTime @map("date_emission") @db.Date
  pdfPath          String?  @map("pdf_path")
  createdById      String?  @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  factureOrigine Facture  @relation("AvoirFactureOrigine", fields: [factureOrigineId], references: [id], onDelete: Restrict)
  commande       Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  createdBy      User?    @relation("AvoirCreatedBy", fields: [createdById], references: [id])

  @@index([factureOrigineId], map: "idx_avoirs_facture")
  @@map("avoirs")
}

// ─── Paiements ────────────────────────────────────────────────────────────────

model Paiement {
  id                  String         @id @default(uuid()) @db.Uuid
  factureId           String         @map("facture_id") @db.Uuid
  montant             Decimal        @db.Decimal(12, 2)
  datePaiement        DateTime       @map("date_paiement") @db.Date
  source              PaiementSource
  referenceExterne    String?        @map("reference_externe") @db.VarChar(100)
  quontoTransactionId String?        @map("quonto_transaction_id") @db.VarChar(100)
  rapprocheAt         DateTime       @default(now()) @map("rapproche_at") @db.Timestamptz(6)
  rapprocheById       String?        @map("rapproche_by") @db.Uuid
  notes               String?

  facture     Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  rapprocheBy User?   @relation("PaiementRapprocheBy", fields: [rapprocheById], references: [id])

  @@index([factureId], map: "idx_paiements_facture")
  @@map("paiements")
}

// ─── Relances ─────────────────────────────────────────────────────────────────

model Relance {
  id             String        @id @default(uuid()) @db.Uuid
  factureId      String        @map("facture_id") @db.Uuid
  niveau         RelanceNiveau
  dateEnvoi      DateTime      @map("date_envoi") @db.Timestamptz(6)
  canal          RelanceCanal
  contenu        String?
  envoyeParId    String?       @map("envoye_par") @db.Uuid
  reponseRecueAt DateTime?     @map("reponse_recue_at") @db.Timestamptz(6)

  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  envoyePar User?   @relation("RelanceEnvoyeePar", fields: [envoyeParId], references: [id])

  @@index([factureId], map: "idx_relances_facture")
  @@map("relances")
}

// ─── Gestionnaires de site ────────────────────────────────────────────────────

model SiteGestionnaire {
  id          String    @id @default(uuid()) @db.Uuid
  legacyId    Int?      @unique @map("legacy_id")
  siteId      String    @map("site_id") @db.Uuid
  clientId    String?   @map("client_id") @db.Uuid
  clientNom   String?   @map("client_nom") @db.VarChar(200)
  contactId   String?   @map("contact_id") @db.Uuid
  contactNom  String?   @map("contact_nom") @db.VarChar(200)
  isPrincipal Boolean   @default(false) @map("is_principal")
  dateDebut   DateTime? @map("date_debut") @db.Date
  dateFin     DateTime? @map("date_fin") @db.Date
  notes       String?

  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("site_gestionnaires")
}

// ─── Phases d'offre ───────────────────────────────────────────────────────────

model PhaseOffre {
  id               String   @id @default(uuid()) @db.Uuid
  offreId          String   @map("offre_id") @db.Uuid
  codePhase        String   @map("code_phase") @db.VarChar(20)
  libelle          String?  @db.VarChar(200)
  montantHt        Decimal? @map("montant_ht") @db.Decimal(12, 2)
  ordre            Int      @default(0)
  estInclus        Boolean  @default(true) @map("est_inclus")
  commentairePhase String?  @map("commentaire_phase")

  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  @@map("phases_offre")
}

// ─── Fichiers & versions ──────────────────────────────────────────────────────

model Fichier {
  id        String   @id @default(uuid()) @db.Uuid
  offreId   String?  @map("offre_id") @db.Uuid
  chemin    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  offre    Offre?           @relation(fields: [offreId], references: [id])
  versions FichierVersion[]

  @@map("fichiers")
}

model FichierVersion {
  id                   String    @id @default(uuid()) @db.Uuid
  legacyId             Int?      @unique @map("legacy_id")
  fichierId            String    @map("fichier_id") @db.Uuid
  versionNum           Int       @map("version_num")
  reference            String?   @db.VarChar(100)
  docType              String?   @map("doc_type") @db.VarChar(20)
  format               String?   @db.VarChar(20)
  storage              String?   @db.VarChar(30)
  s3Path               String?   @map("s3_path")
  minioKey             String?   @map("minio_key") @db.Text
  onedrivePath         String?   @map("onedrive_path")
