# Prisma (racine)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lvo_crm?schema=public"

# API Express (dossier server/) — port 8080
API_PORT=8080
JWT_SECRET=changez-moi-en-production
# Optionnel : si défini, POST /api/webhooks/quonto exige x-qonto-signature (HMAC-SHA256 du corps brut)
QUONTO_WEBHOOK_SECRET=

# Backend Spring Boot (dossier backend/) — port 8090 (évite conflit avec Express 8080)
# En production cloud (Render) la variable PORT est injectée automatiquement par la plateforme.
BACKEND_PORT=8090

# Frontend Next.js (dossier frontend/) — port 3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend Spring (backend/.env) — arborescence OneDrive à la création de site
# Voir backend/.env.example pour le détail (AZURE_*, ONEDRIVE_*).

# Envoi d'emails (notifications admin / client / ascensoriste) — dossier server/
# Si SMTP_HOST est vide, les emails sont simplement logués en console (aucun envoi réel).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="LVO Ingénierie <notifications@lvo-ing.fr>"
